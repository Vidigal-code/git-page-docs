{
  "id": "cloud-harbor-dark",
  "name": "Cloud Harbor Dark",
  "author": "Kauan Vidigal",
  "version": "1.0.0",
  "mode": "dark",
  "supportsLightAndDarkModes": true,
  "colors": {
    "background": "#142438",
