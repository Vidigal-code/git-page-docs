{
  "id": "alpine-meadow-light",
  "name": "Alpine Meadow Light",
  "author": "Kauan Vidigal",
  "version": "1.0.0",
  "mode": "light",
  "supportsLightAndDarkModes": true,
  "colors": {
    "background": "#F2FCF2",
    "primary": "#166534",
    "secondary": "#0369A1",
    "text": "#294B35",
    "textSecondary": "#526269",
    "cardBackground": "#FFFFFF",
    "cardBorder": "#C4E1C6",
    "error": "#B91C1C",
    "success": "#15803D"
