{
  "id": "starfall-cobalt-dark",
  "name": "Starfall Cobalt",
  "author": "Kauan Vidigal",
  "version": "1.0.0",
  "mode": "dark",
  "supportsLightAndDarkModes": false,
  "colors": {
    "background": "#060F2B",
    "primary": "#60A5FA",
    "secondary": "#BFDBFE",
    "text": "#EAF2FF",
    "textSecondary": "#A7B9CE",
    "cardBackground": "#101F40",
    "cardBorder": "#294575",
    "error": "#FDA4AF",
    "success": "#86EFAC"
  },
  "typography": {
    "fontFamily": "-apple-system, BlinkMacSystemFont, 'Segoe UI', Inter, Roboto, Helvetica, Arial, sans-serif",
    "fontSize": {
      "small": "0.875rem",
      "base": "1rem",
      "medium": "1.125rem",
      "large": "1.25rem",
      "xlarge": "2rem"
    }
  },
  "components": {
    "header": {
      "height": "80px",
      "backgroundColor": "#0B1220",
      "borderBottom": "1px solid #334155"
    },
    "footer": {
      "height": "60px",
      "backgroundColor": "#0B1220",
      "borderTop": "1px solid #334155"
    },
    "card": {
      "borderRadius": "16px",
      "padding": "24px",
      "boxShadow": "0 18px 60px rgba(0, 0, 0, 0.45)"
    },
    "button": {
      "borderRadius": "12px",
      "padding": "10px 18px",
      "border": "1px solid #294575",
      "hoverGlow": "0 0 0 3px rgba(96, 165, 250, 0.18)"
    },
    "select": {
      "borderRadius": "12px",
      "padding": "10px 40px 10px 16px",
      "border": "1px solid #294575",
      "backgroundColor": "#101F40",
      "textAlign": "center",
      "iconColor": "#BFDBFE",
      "hoverBorderColor": "rgba(96, 165, 250, 0.7)",
      "focusBorderColor": "rgba(96, 165, 250, 0.85)",
      "focusGlow": "0 0 0 4px rgba(96, 165, 250, 0.18)"
    },
    "checkbox": {
      "width": "20px",
      "height": "20px",
      "accentColor": "#60A5FA",
      "borderColor": "#475569",
      "hoverBorderColor": "rgba(34, 211, 238, 0.75)",
      "checkMarkColor": "#060F2B",
      "borderRadius": "6px"
    }
  },
  "animations": {
    "enableTypingEffect": false,
    "enableGlow": true,
    "transitionDuration": "0.22s"
  },
  "backgroundEffects": {
    "enabled": true,
    "surface": "radial-gradient(ellipse at 35% 0%, #101F40 0%, #060F2B 70%)",
    "opacity": 1,
    "animation": {
      "enabled": true,
      "speed": 0.9
    },
    "parallax": {
      "enabled": true,
      "pointer": 10,
      "scroll": 0.025
    },
    "accessibility": {
      "reducedMotion": "static",
      "showPauseButton": true
