{
  "id": "cloud-harbor-light",
  "name": "Cloud Harbor Light",
  "author": "Kauan Vidigal",
  "version": "1.0.0",
  "mode": "light",
  "supportsLightAndDarkModes": true,
  "colors": {
    "background": "#F3FAFF",
    "primary": "#0369A1",
    "secondary": "#92400E",
    "text": "#213D50",
    "textSecondary": "#526269",
    "cardBackground": "#FFFFFF",
    "cardBorder": "#C8E0EC",
    "error": "#B91C1C",
    "success": "#15803D"
  },
  "typography": {
    "fontFamily": "-apple-system, BlinkMacSystemFont, 'Segoe UI', Inter, Roboto, Helvetica, Arial, sans-serif",
    "fontSize": {
      "small": "0.875rem",
      "base": "1rem",
      "medium": "1.125rem",
      "large": "1.25rem",
      "xlarge": "2rem"
    }
  },
  "components": {
    "header": {
      "height": "80px",
      "backgroundColor": "#FFFFFF",
      "borderBottom": "1px solid #E2E8F0"
    },
    "footer": {
      "height": "60px",
      "backgroundColor": "#FFFFFF",
      "borderTop": "1px solid #E2E8F0"
    },
    "card": {
      "borderRadius": "16px",
      "padding": "24px",
      "boxShadow": "0 18px 50px rgba(15, 23, 42, 0.08)"
    },
    "button": {
      "borderRadius": "12px",
      "padding": "10px 18px",
      "border": "1px solid #C8E0EC",
      "hoverGlow": "0 0 0 3px rgba(3, 105, 161, 0.18)"
    },
    "select": {
      "borderRadius": "12px",
      "padding": "10px 40px 10px 16px",
      "border": "1px solid #C8E0EC",
      "backgroundColor": "#FFFFFF",
      "textAlign": "center",
      "iconColor": "#92400E",
      "hoverBorderColor": "rgba(3, 105, 161, 0.7)",
      "focusBorderColor": "rgba(3, 105, 161, 0.85)",
      "focusGlow": "0 0 0 4px rgba(3, 105, 161, 0.18)"
    },
    "checkbox": {
      "width": "20px",
      "height": "20px",
      "accentColor": "#0369A1",
      "borderColor": "#CBD5E1",
      "hoverBorderColor": "rgba(8, 145, 178, 0.7)",
      "checkMarkColor": "#F3FAFF",
      "borderRadius": "6px"
    }
  },
  "animations": {
    "enableTypingEffect": false,
    "enableGlow": false,
    "transitionDuration": "0.22s"
  },
  "backgroundEffects": {
    "enabled": true,
    "surface": "radial-gradient(ellipse at 35% 50%, #FFFFFF 0%, #F3FAFF 78%)",
    "opacity": 1,
    "animation": {
      "enabled": true,
      "speed": 0.75
    },
    "parallax": {
      "enabled": true,
      "pointer": 16,
      "scroll": 0.06
    },
    "accessibility": {
      "reducedMotion": "static",
      "showPauseButton": true
    },
    "layers": [
      {
        "id": "cloud-harbor-orbs-1",
