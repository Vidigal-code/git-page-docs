{
  "id": "duet-dark",
  "name": "Duet Dark",
  "author": "Kauan Vidigal",
  "version": "1.0.0",
  "mode": "dark",
  "supportsLightAndDarkModes": true,
  "colors": {
    "background": "#000000",
    "primary": "#FFFFFF",
    "secondary": "#AFAFAF",
    "text": "#FFFFFF",
    "textSecondary": "#AFAFAF",
    "cardBackground": "#282828",
    "cardBorder": "#4B4B4B",
    "error": "#FFFFFF",
    "success": "#FFFFFF"
  },
  "typography": {
    "fontFamily": "Inter, -apple-system, BlinkMacSystemFont, 'Segoe UI', Helvetica, Arial, sans-serif",
    "fontSize": {
      "small": "0.875rem",
      "base": "1rem",
      "medium": "1.125rem",
      "large": "1.5rem",
      "xlarge": "2.25rem"
    }
  },
  "components": {
    "header": {
      "height": "64px",
      "backgroundColor": "#000000",
      "borderBottom": "1px solid #4B4B4B"
    },
    "footer": {
      "height": "60px",
      "backgroundColor": "#000000",
      "borderTop": "1px solid #4B4B4B"
    },
    "card": {
      "borderRadius": "16px",
      "padding": "24px",
      "boxShadow": "none"
    },
    "button": {
      "borderRadius": "999px",
      "padding": "10px 16px",
      "border": "1px solid #FFFFFF",
      "hoverGlow": "0 0 0 3px rgba(255, 255, 255, 0.16)"
    },
    "select": {
      "borderRadius": "999px",
      "padding": "10px 40px 10px 16px",
      "border": "1px solid #4B4B4B",
      "backgroundColor": "#282828",
      "textAlign": "center",
      "iconColor": "#FFFFFF",
      "hoverBorderColor": "#FFFFFF",
      "focusBorderColor": "#FFFFFF",
      "focusGlow": "0 0 0 3px rgba(255, 255, 255, 0.2)"
    },
    "checkbox": {
      "width": "20px",
      "height": "20px",
      "accentColor": "#FFFFFF",
      "borderColor": "#4B4B4B",
      "hoverBorderColor": "#FFFFFF",
      "checkMarkColor": "#000000",
      "borderRadius": "6px"
    }
  },
  "animations": {
    "enableTypingEffect": false,
    "enableGlow": false,
    "transitionDuration": "0.15s"
  }
}
