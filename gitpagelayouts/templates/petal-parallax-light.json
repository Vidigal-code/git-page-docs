{
  "id": "petal-parallax-light",
  "name": "Petal Parallax",
  "author": "Kauan Vidigal",
  "version": "1.0.0",
  "mode": "light",
  "supportsLightAndDarkModes": false,
  "colors": {
    "background": "#FDF2F8",
