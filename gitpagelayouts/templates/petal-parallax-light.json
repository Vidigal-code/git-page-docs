  "typography": {
    "fontFamily": "-apple-system, BlinkMacSystemFont, 'Segoe UI', Inter, Roboto, Helvetica, Arial, sans-serif",
    "fontSize": {
      "small": "0.875rem",
      "base": "1rem",
      "medium": "1.125rem",
      "large": "1.25rem",
      "xlarge": "2rem"
    }
  },
  "components": {
    "header": {
      "height": "80px",
      "backgroundColor": "#FFFFFF",
      "borderBottom": "1px solid #E2E8F0"
    },
    "footer": {
      "height": "60px",
      "backgroundColor": "#FFFFFF",
      "borderTop": "1px solid #E2E8F0"
    },
    "card": {
      "borderRadius": "16px",
      "padding": "24px",
      "boxShadow": "0 18px 50px rgba(15, 23, 42, 0.08)"
    },
    "button": {
      "borderRadius": "12px",
      "padding": "10px 18px",
      "border": "1px solid #F2CBE6",
      "hoverGlow": "0 0 0 3px rgba(162, 28, 175, 0.18)"
    },
    "select": {
      "borderRadius": "12px",
      "padding": "10px 40px 10px 16px",
      "border": "1px solid #F2CBE6",
      "backgroundColor": "#FFFFFF",
      "textAlign": "center",
      "iconColor": "#BE185D",
      "hoverBorderColor": "rgba(162, 28, 175, 0.7)",
      "focusBorderColor": "rgba(162, 28, 175, 0.85)",
      "focusGlow": "0 0 0 4px rgba(162, 28, 175, 0.18)"
    },
    "checkbox": {
      "width": "20px",
      "height": "20px",
      "accentColor": "#A21CAF",
      "borderColor": "#CBD5E1",
      "hoverBorderColor": "rgba(8, 145, 178, 0.7)",
      "checkMarkColor": "#FDF2F8",
      "borderRadius": "6px"
    }
  },
  "animations": {
    "enableTypingEffect": false,
    "enableGlow": false,
    "transitionDuration": "0.22s"
  },
