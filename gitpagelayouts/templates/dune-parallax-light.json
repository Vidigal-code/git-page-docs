{
  "id": "dune-parallax-light",
  "name": "Dune Parallax",
  "author": "Kauan Vidigal",
  "version": "1.0.0",
  "mode": "light",
  "supportsLightAndDarkModes": false,
  "colors": {
    "background": "#FCF7ED",
    "primary": "#92400E",
    "secondary": "#9A3412",
    "text": "#17233B",
    "textSecondary": "#475569",
    "cardBackground": "#FFFFFF",
    "cardBorder": "#E8D5AF",
    "error": "#B91C1C",
    "success": "#15803D"
  },
  "typography": {
    "fontFamily": "-apple-system, BlinkMacSystemFont, 'Segoe UI', Inter, Roboto, Helvetica, Arial, sans-serif",
    "fontSize": {
      "small": "0.875rem",
      "base": "1rem",
      "medium": "1.125rem",
      "large": "1.25rem",
      "xlarge": "2rem"
    }
  },
  "components": {
    "header": {
      "height": "80px",
      "backgroundColor": "#FFFFFF",
      "borderBottom": "1px solid #E2E8F0"
    },
    "footer": {
      "height": "60px",
      "backgroundColor": "#FFFFFF",
      "borderTop": "1px solid #E2E8F0"
    },
    "card": {
      "borderRadius": "16px",
      "padding": "24px",
      "boxShadow": "0 18px 50px rgba(15, 23, 42, 0.08)"
    },
    "button": {
      "borderRadius": "12px",
      "padding": "10px 18px",
      "border": "1px solid #E8D5AF",
      "hoverGlow": "0 0 0 3px rgba(146, 64, 14, 0.18)"
    },
    "select": {
      "borderRadius": "12px",
      "padding": "10px 40px 10px 16px",
      "border": "1px solid #E8D5AF",
      "backgroundColor": "#FFFFFF",
      "textAlign": "center",
      "iconColor": "#9A3412",
      "hoverBorderColor": "rgba(146, 64, 14, 0.7)",
      "focusBorderColor": "rgba(146, 64, 14, 0.85)",
      "focusGlow": "0 0 0 4px rgba(146, 64, 14, 0.18)"
    },
    "checkbox": {
      "width": "20px",
      "height": "20px",
      "accentColor": "#92400E",
      "borderColor": "#CBD5E1",
      "hoverBorderColor": "rgba(8, 145, 178, 0.7)",
      "checkMarkColor": "#FCF7ED",
      "borderRadius": "6px"
    }
  },
  "animations": {
    "enableTypingEffect": false,
    "enableGlow": false,
    "transitionDuration": "0.22s"
  },
  "backgroundEffects": {
    "enabled": true,
    "surface": "radial-gradient(ellipse at 75% 0%, #FFFFFF 0%, #FCF7ED 70%)",
    "opacity": 1,
    "animation": {
      "enabled": true,
      "speed": 0.9
    },
    "parallax": {
      "enabled": true,
      "pointer": 24,
      "scroll": 0.08
    },
    "accessibility": {
      "reducedMotion": "static",
      "showPauseButton": true
    },
    "layers": [
      {
        "id": "waves-1",
        "kind": "waves",
        "count": 3,
        "opacity": 0.10400000000000001,
