{
  "id": "matrix-paper-light",
  "name": "Matrix Paper",
  "author": "Kauan Vidigal",
  "version": "1.0.0",
  "mode": "light",
  "supportsLightAndDarkModes": false,
  "colors": {
    "background": "#F6FAF5",
    "primary": "#166534",
    "secondary": "#4D7C0F",
    "text": "#17233B",
    "textSecondary": "#475569",
    "cardBackground": "#FFFFFF",
    "cardBorder": "#D1E3CD",
    "error": "#B91C1C",
    "success": "#15803D"
  },
  "typography": {
    "fontFamily": "-apple-system, BlinkMacSystemFont, 'Segoe UI', Inter, Roboto, Helvetica, Arial, sans-serif",
    "fontSize": {
      "small": "0.875rem",
      "base": "1rem",
      "medium": "1.125rem",
      "large": "1.25rem",
      "xlarge": "2rem"
    }
  },
  "components": {
    "header": {
      "height": "80px",
      "backgroundColor": "#FFFFFF",
      "borderBottom": "1px solid #E2E8F0"
    },
    "footer": {
      "height": "60px",
      "backgroundColor": "#FFFFFF",
      "borderTop": "1px solid #E2E8F0"
    },
    "card": {
      "borderRadius": "16px",
      "padding": "24px",
      "boxShadow": "0 18px 50px rgba(15, 23, 42, 0.08)"
    },
    "button": {
      "borderRadius": "12px",
      "padding": "10px 18px",
      "border": "1px solid #D1E3CD",
      "hoverGlow": "0 0 0 3px rgba(22, 101, 52, 0.18)"
    },
    "select": {
      "borderRadius": "12px",
      "padding": "10px 40px 10px 16px",
      "border": "1px solid #D1E3CD",
      "backgroundColor": "#FFFFFF",
      "textAlign": "center",
      "iconColor": "#4D7C0F",
      "hoverBorderColor": "rgba(22, 101, 52, 0.7)",
      "focusBorderColor": "rgba(22, 101, 52, 0.85)",
      "focusGlow": "0 0 0 4px rgba(22, 101, 52, 0.18)"
    },
    "checkbox": {
      "width": "20px",
      "height": "20px",
      "accentColor": "#166534",
      "borderColor": "#CBD5E1",
      "hoverBorderColor": "rgba(8, 145, 178, 0.7)",
      "checkMarkColor": "#F6FAF5",
      "borderRadius": "6px"
    }
  },
  "animations": {
    "enableTypingEffect": false,
    "enableGlow": false,
    "transitionDuration": "0.22s"
  },
  "backgroundEffects": {
    "enabled": true,
    "surface": "radial-gradient(ellipse at 15% 0%, #FFFFFF 0%, #F6FAF5 70%)",
    "opacity": 1,
    "animation": {
      "enabled": true,
      "speed": 0.8
    },
    "parallax": {
      "enabled": true,
      "pointer": 10,
      "scroll": 0.025
    },
    "accessibility": {
      "reducedMotion": "static",
      "showPauseButton": true
    },
