{
  "id": "forest-canopy-light",
  "name": "Forest Canopy Light",
  "author": "Kauan Vidigal",
  "version": "1.0.0",
  "mode": "light",
  "supportsLightAndDarkModes": true,
  "colors": {
    "background": "#F1F8ED",
    "primary": "#166534",
    "secondary": "#92400E",
    "text": "#253E27",
    "textSecondary": "#526269",
    "cardBackground": "#FFFFFF",
    "cardBorder": "#C4D8BD",
    "error": "#B91C1C",
    "success": "#15803D"
  },
  "typography": {
    "fontFamily": "-apple-system, BlinkMacSystemFont, 'Segoe UI', Inter, Roboto, Helvetica, Arial, sans-serif",
    "fontSize": {
      "small": "0.875rem",
      "base": "1rem",
      "medium": "1.125rem",
      "large": "1.25rem",
      "xlarge": "2rem"
    }
  },
  "components": {
    "header": {
      "height": "80px",
      "backgroundColor": "#FFFFFF",
      "borderBottom": "1px solid #E2E8F0"
    },
    "footer": {
      "height": "60px",
      "backgroundColor": "#FFFFFF",
      "borderTop": "1px solid #E2E8F0"
    },
    "card": {
      "borderRadius": "16px",
      "padding": "24px",
      "boxShadow": "0 18px 50px rgba(15, 23, 42, 0.08)"
    },
    "button": {
      "borderRadius": "12px",
      "padding": "10px 18px",
      "border": "1px solid #C4D8BD",
      "hoverGlow": "0 0 0 3px rgba(22, 101, 52, 0.18)"
    },
    "select": {
      "borderRadius": "12px",
      "padding": "10px 40px 10px 16px",
      "border": "1px solid #C4D8BD",
      "backgroundColor": "#FFFFFF",
      "textAlign": "center",
      "iconColor": "#92400E",
      "hoverBorderColor": "rgba(22, 101, 52, 0.7)",
      "focusBorderColor": "rgba(22, 101, 52, 0.85)",
      "focusGlow": "0 0 0 4px rgba(22, 101, 52, 0.18)"
    },
    "checkbox": {
      "width": "20px",
      "height": "20px",
      "accentColor": "#166534",
      "borderColor": "#CBD5E1",
      "hoverBorderColor": "rgba(8, 145, 178, 0.7)",
      "checkMarkColor": "#F1F8ED",
      "borderRadius": "6px"
    }
  },
  "animations": {
    "enableTypingEffect": false,
    "enableGlow": false,
    "transitionDuration": "0.22s"
  },
  "backgroundEffects": {
    "enabled": true,
    "surface": "radial-gradient(ellipse at 65% 10%, #FFFFFF 0%, #F1F8ED 78%)",
