{
  "$schema": "gitpagelayouts/v2",
  "description": "Shared values of every official layout. Layout files in layouts/ only carry identity, colors and overrides; `npm run layouts:sync` expands them into templates/<id>.json.",
  "shared": {
    "author": "Kauan Vidigal",
    "version": "1.0.0",
    "typography": {
      "fontSize": {
        "small": "0.875rem",
        "base": "1rem",
        "medium": "1.125rem"
      }
    },
    "components": {
      "footer": {
        "height": "60px"
      },
      "card": {
        "borderRadius": "16px",
        "padding": "24px"
      },
      "select": {
        "padding": "10px 40px 10px 16px",
        "textAlign": "center"
      },
      "checkbox": {
        "width": "20px",
        "height": "20px",
        "borderRadius": "6px"
      }
    },
    "animations": {
      "enableTypingEffect": false
    }
  },
  "modes": {
    "dark": {
      "typography": {
        "fontFamily": "-apple-system, BlinkMacSystemFont, 'Segoe UI', Inter, Roboto, Helvetica, Arial, sans-serif",
        "fontSize": {
          "large": "1.25rem",
          "xlarge": "2rem"
        }
      },
      "components": {
        "header": {
          "height": "80px",
          "backgroundColor": "#0B1220",
          "borderBottom": "1px solid #334155"
        },
        "footer": {
          "backgroundColor": "#0B1220",
          "borderTop": "1px solid #334155"
        },
        "card": {
          "boxShadow": "0 18px 60px rgba(0, 0, 0, 0.45)"
        },
        "button": {
          "borderRadius": "12px",
          "padding": "10px 18px"
        },
        "select": {
          "borderRadius": "12px"
        },
        "checkbox": {
          "borderColor": "#475569",
          "hoverBorderColor": "rgba(34, 211, 238, 0.75)"
        }
      },
      "animations": {
        "enableGlow": true,
        "transitionDuration": "0.22s"
      }
    },
    "light": {
      "typography": {
        "fontFamily": "-apple-system, BlinkMacSystemFont, 'Segoe UI', Inter, Roboto, Helvetica, Arial, sans-serif",
        "fontSize": {
          "large": "1.25rem",
          "xlarge": "2rem"
        }
      },
      "components": {
        "header": {
          "height": "80px",
          "backgroundColor": "#FFFFFF",
          "borderBottom": "1px solid #E2E8F0"
        },
        "footer": {
          "backgroundColor": "#FFFFFF",
          "borderTop": "1px solid #E2E8F0"
        },
        "card": {
          "boxShadow": "0 18px 50px rgba(15, 23, 42, 0.08)"
        },
        "button": {
          "borderRadius": "12px",
          "padding": "10px 18px"
        },
        "select": {
          "borderRadius": "12px"
        },
        "checkbox": {
          "borderColor": "#CBD5E1",
          "hoverBorderColor": "rgba(8, 145, 178, 0.7)"
        }
      },
      "animations": {
        "enableGlow": false,
        "transitionDuration": "0.22s"
      }
    }
  },
  "derived": {
    "components.button.border": "1px solid {cardBorder}",
    "components.button.hoverGlow": "0 0 0 3px {primary|0.18}",
    "components.select.border": "1px solid {cardBorder}",
    "components.select.backgroundColor": "{cardBackground}",
    "components.select.iconColor": "{secondary}",
    "components.select.hoverBorderColor": "{primary|0.7}",
    "components.select.focusBorderColor": "{primary|0.85}",
    "components.select.focusGlow": "0 0 0 4px {primary|0.18}",
    "components.checkbox.accentColor": "{primary}",
    "components.checkbox.checkMarkColor": "{background}"
  }
}
