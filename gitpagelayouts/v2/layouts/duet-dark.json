{
  "id": "duet-dark",
  "name": "Duet Dark",
  "mode": "dark",
  "supportsLightAndDarkModes": true,
  "colors": {
    "background": "#000000",
    "primary": "#FFFFFF",
    "secondary": "#AFAFAF",
    "text": "#FFFFFF",
    "textSecondary": "#AFAFAF",
    "cardBackground": "#282828",
    "cardBorder": "#4B4B4B",
    "error": "#FFFFFF",
    "success": "#FFFFFF"
  },
  "overrides": {
    "typography": {
      "fontFamily": "Inter, -apple-system, BlinkMacSystemFont, 'Segoe UI', Helvetica, Arial, sans-serif",
      "fontSize": {
        "large": "1.5rem",
        "xlarge": "2.25rem"
      }
    },
    "components": {
      "header": {
        "height": "64px",
        "backgroundColor": "#000000",
        "borderBottom": "1px solid #4B4B4B"
      },
      "footer": {
        "backgroundColor": "#000000",
        "borderTop": "1px solid #4B4B4B"
      },
      "card": {
        "boxShadow": "none"
      },
      "button": {
        "borderRadius": "999px",
        "padding": "10px 16px",
        "border": "1px solid #FFFFFF",
        "hoverGlow": "0 0 0 3px rgba(255, 255, 255, 0.16)"
      },
      "select": {
        "borderRadius": "999px",
        "iconColor": "#FFFFFF",
        "hoverBorderColor": "#FFFFFF",
        "focusBorderColor": "#FFFFFF",
        "focusGlow": "0 0 0 3px rgba(255, 255, 255, 0.2)"
      },
      "checkbox": {
        "borderColor": "#4B4B4B",
        "hoverBorderColor": "#FFFFFF"
      }
    },
    "animations": {
      "enableGlow": false,
      "transitionDuration": "0.15s"
    }
  }
}
