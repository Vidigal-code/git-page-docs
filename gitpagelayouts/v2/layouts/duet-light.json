{
  "id": "duet-light",
  "name": "Duet Light",
  "mode": "light",
  "supportsLightAndDarkModes": true,
  "colors": {
    "background": "#FFFFFF",
    "primary": "#000000",
    "secondary": "#5E5E5E",
    "text": "#000000",
    "textSecondary": "#5E5E5E",
    "cardBackground": "#FFFFFF",
    "cardBorder": "#E2E2E2",
    "error": "#000000",
    "success": "#000000"
  },
  "overrides": {
    "typography": {
      "fontFamily": "Inter, -apple-system, BlinkMacSystemFont, 'Segoe UI', Helvetica, Arial, sans-serif",
      "fontSize": {
        "large": "1.5rem",
        "xlarge": "2.25rem"
      }
    },
    "components": {
      "header": {
        "height": "64px",
        "borderBottom": "1px solid #E2E2E2"
      },
      "footer": {
        "backgroundColor": "#000000",
        "borderTop": "1px solid #000000"
      },
      "card": {
        "boxShadow": "none"
      },
      "button": {
        "borderRadius": "999px",
        "padding": "10px 16px",
        "border": "1px solid #000000",
        "hoverGlow": "0 0 0 3px rgba(0, 0, 0, 0.12)"
      },
      "select": {
        "borderRadius": "999px",
        "backgroundColor": "#EFEFEF",
        "iconColor": "#000000",
        "hoverBorderColor": "#000000",
        "focusBorderColor": "#000000",
        "focusGlow": "0 0 0 3px rgba(0, 0, 0, 0.16)"
      },
      "checkbox": {
        "borderColor": "#AFAFAF",
        "hoverBorderColor": "#000000"
      }
    },
    "animations": {
      "transitionDuration": "0.15s"
    }
  }
}
